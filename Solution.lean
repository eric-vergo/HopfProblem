def SphereHomology.suspensionSphereMap (n : ℕ) :
    CuspCentralHomology.Suspension (UnitSphere n) → UnitSphere (n + 1) :=
  Quotient.lift (fun p => Latitude.point n p.1 p.2)
    (fun p q h => (Latitude.point_eq_iff n p.1 q.1 p.2 q.2).mpr h)

