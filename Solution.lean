@[simp]
theorem FourthHurewicz.CubeSubdivision.PermutationInsertion.insert_symm_apply_zero {n : ℕ}
    (k : Fin (n + 1)) (e : Equiv.Perm (Fin n)) :
    (FourthHurewicz.CubeSubdivision.PermutationInsertion.insert k e).symm 0 = k := by
