theorem SpecialPeriods.Triangle.sl_analyticOrderAt_comp_smul (f : ℍ → ℂ) (g : SL(2, ℝ)) (z : ℍ) :
    analyticOrderAt (fun w : ℂ => f (g • UpperHalfPlane.ofComplex w)) (z : ℂ) =
      analyticOrderAt (f ∘ UpperHalfPlane.ofComplex) ((g • z : ℍ) : ℂ) := by
