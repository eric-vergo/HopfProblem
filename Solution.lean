  Continuous.homeoOfEquivCompactToT2 (f :=
    Equiv.ofBijective (suspensionSphereMap n)
      ⟨suspensionSphereMap_injective n, suspensionSphereMap_surjective n⟩)
    (suspensionSphereMap_continuous n)

