    · simpa [nativeCubeCutUpperMap, hj] using hb u
    · exact p.property _ ⟨i, Or.inr (by simp [nativeCubeCutUpperMap, hj])⟩
  · exact p.property _ ⟨j, by simpa [nativeCubeCutUpperMap, hji] using hj⟩

