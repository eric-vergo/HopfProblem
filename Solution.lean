      (SpecialPeriods.Triangle.cuspFullChart SpecialPeriods.Triangle.width le_rfl)
      SpecialPeriods.triangleCuspPoint :=
    SpecialPeriods.triangleCompactified_cuspChart_holomorphic.contMDiffAt
