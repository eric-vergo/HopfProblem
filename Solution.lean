        ((PeriodFamily.Boundary.EllipticCapProduct.boundaryCapH4KernelEquiv j).symm ![1, 0]) =
      (j.order : ℤ) • ![0, 0, 0, 1] := by
  rw [capKernelWangH4Coordinates_symm]
  cases j
