        (HigherHurewicz.CubeTriangulation.cubeSimplex e) =
      SecondHurewicz.SimplyConnected.timeSlice
        (H₁ (p.val.comp (HigherHurewicz.CubeTriangulation.cubeSimplex e))) 1 := by
