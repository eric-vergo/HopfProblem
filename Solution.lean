theorem PeriodTorusHigherHomology.formalMap_associatorHomotopy {V W Z V' W' Z' : Type*}
    (f : V → V') (g : W → W') (h : Z → Z') :
    ∀ (q : ℕ) (a : SingularMayerVietoris.FormalChains V 2)
      (b : SingularMayerVietoris.FormalChains W 2)
