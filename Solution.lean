@[simp]
theorem ThirdHurewicz.nativeOrderedDuffyMap_cycle201 (u : NativeCube) :
    nativeOrderedDuffyMap nativeCubeCycle201 u = ![u 2 * u 0, u 2 * u 0 * u 1, u 2] := by
