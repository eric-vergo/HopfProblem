theorem CuspRetraction.polarSpread_fibre_torus_equivariant {η : ℝ}
    (P : C(unitInterval × ToricSpace.ClosedPositiveTube η, ToricSpace.ClosedPositiveTube η))
    (hfix :
      ∀ (s : unitInterval) (q : ToricSpace.ClosedPositiveTube η),
