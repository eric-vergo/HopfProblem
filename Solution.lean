  rcases hc with rfl | rfl
  · rw [cyclicPowerHom_one]
    exact Set.smul_set_subset_iff.mpr h₁
  · rw [tiling_cyclicPowerHom_two_mo1973_18652]
    exact Set.smul_set_subset_iff.mpr h₂

