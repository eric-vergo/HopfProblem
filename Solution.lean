def SpecialPeriods.Triangle.secondWeakExcluded : Set ℍ :=
  {z | z.re ≤ stripLeft ∨ ‖(z : ℂ) - (stripLeft : ℂ)‖ ≤ stripRight}

def SpecialPeriods.Triangle.circularDoubleRegion : Set ℍ :=
