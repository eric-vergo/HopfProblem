    (p : GenLoop (Fin 6) X x) :
    suspensionOne x (FirstHurewicz.pathChain (GenLoop.toLoop (0 : Fin 6) p)) =
      FirstHurewicz.inducedChain (cubeMap p) 6 productCubeChain := by
