        linarith
      · change ((y.1 : ℂ) - (n : ℂ)).im = (x.1 : ℂ).im
        simpa only [Complex.sub_im, Complex.intCast_im, sub_zero] using hheight.symm
    · change SpecialPeriods.CuspFamily.cuspTorusHomeomorph n y.2 = x.2
      change y.2 = (monodromy ^ (-n)) x.2 at hx
