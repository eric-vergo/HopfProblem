  SpecialPeriods.Threefold.VerticalAction.Factor.AdditiveFlow.apply_eq_of_parameterProjection_eq
    {M : Type*} (F : SpecialPeriods.Threefold.VerticalAction.Factor.AdditiveFlow M) {s t : ℂ}
