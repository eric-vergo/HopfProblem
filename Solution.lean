theorem ThreefoldOverlapMappingTorus.Cusp.boundaryCylinder_realCoordinates
    (D : SpecialPeriods.CuspFamily.Data) (h : Height D.radius) (t : ℝ) (x : RealPlane₄) :
    boundaryCylinder D h (t, standardLattice.mkQ x) =
