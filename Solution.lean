  intro a b
  induction a using Quotient.inductionOn with
  | _ p =>
    induction b using Quotient.inductionOn with
    | _ q =>
      intro h
      exact Quotient.sound ((Latitude.point_eq_iff n p.1 q.1 p.2 q.2).mp h)

