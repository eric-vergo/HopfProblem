@[simp]
theorem SpecialPeriods.CuspFamily.logBaseToRegular_cuspQ (r : ℝ)
    (hrcap : r ≤ SpecialPeriods.Triangle.cuspRadius SpecialPeriods.Triangle.width)
    (s : LogBase r) :
    SpecialPeriods.Triangle.cuspQ (logBaseToRegular r hrcap s : ℍ) =
