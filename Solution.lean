  intro hg a b k l h B
  have hT : IsClosed (Set.range d.surgery.beltSphere) := d.belt_isClosedEmbedding.isClosed_range
  have hnullbelt :=
    d.chart.surgery_beltComplement_circle_nullhomotopies hf d.radius d.radius_pos d.block
