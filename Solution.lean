    (smp : FirstHurewicz.SingularSimplex X 7) :
    ∑ i : Fin 8,
        (-1 : ℤ) ^ i.val •
          basedSixSimplexClass
            (normalizedSixSimplex x (smp.comp (FirstHurewicz.simplexFace 6 i))) =
