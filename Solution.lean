            (SingularMayerVietoris.formalBoundary (q + 2) (SingularMayerVietoris.formalSimplex z))
      have hz :
        SingularMayerVietoris.formalBoundary (q + 4)
            (formalAssociatorDefect (q + 2) (SingularMayerVietoris.formalSimplex v)
