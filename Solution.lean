    (by
      apply continuous_sigma
      intro i
      exact (Smale.DisjointOpenHomology.inclusion W i).continuous)
    (by
      apply isOpenMap_sigma.mpr
      intro i
      exact (hW i).isOpenMap_inclusion (Set.subset_iUnion W i))

