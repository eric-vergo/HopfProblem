  by_cases ht : t ≤ 1 / 4
  · exact sin_two_pi_gt_half_of_le_quarter_mo1973_26635 t ht0 ht
  · have h :=
      sin_two_pi_gt_half_of_le_quarter_mo1973_26635 (1 / 2 - t) (by linarith) (by linarith)
