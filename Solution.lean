@[simp]
theorem Elliptic.HigherHomology.periodDeckCoinvariantsH3Equiv_fibre (j : Elliptic.Kind)
    (p : Elliptic.FixedPeriod j)
    (a : SingularMayerVietoris.SingularHomology (PeriodTorusHigherHomology.ProductTorus 3) 3) :
