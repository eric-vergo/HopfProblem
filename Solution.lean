        ((1 : ℂ) : RiemannSphere)) :
    PeriodFamily.Data ℂ SpecialPeriods.TriangleRegularPoint :=
  PeriodFamily.regularData (SpecialPeriods.Construction.periodMapOfSphere π hπ h₀ h₁)
    (SpecialPeriods.Construction.periodMapOfSphere_generator₁ π hπ h₀ h₁)
    (SpecialPeriods.Construction.periodMapOfSphere_generator₂ π hπ h₀ h₁)

