theorem Smale.ManifoldMorse.SignedMorseChart.normHandleMap_belt_height {E M : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace M] [ChartedSpace E M] {f : M → ℝ}
