        (MappingTorusHomology.monodromyHomologyMap
          (ThreefoldOverlapMappingTorus.monodromy Option.none) 3 a) =
      PeriodTorusHigherHomologyExterior.cubeM₀ *ᵥ
        PeriodFamily.FlatTorus.singularH3Coordinates a := by
