theorem PeriodFamily.BoundaryCircleSlits.shiftedCircle_re (b : Bool)
    (r : PeriodFamily.BoundaryRadius.SmallRadius) (t : ℝ) :
    (shiftedCircle b r t : ℂ).re = (if b then 1 else 0) + (r : ℝ) * Real.sin (2 * Real.pi * t) := by
