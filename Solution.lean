    (PeriodFamily.FlatTorus.singularH3Coordinates.toAddEquiv.toAddMonoidHom.comp
      ((MappingTorusHomology.wangBoundary (Elliptic.flatTorusAffine j j.twist)
            3).toAddMonoidHom.comp
        (LinearMap.ker
