theorem Elliptic.HigherHomology.surfaceH1Equiv_periodCover_fibre (j : Elliptic.Kind)
    (p : Elliptic.FixedPeriod j)
    (a : SingularMayerVietoris.SingularHomology (PeriodTorusHigherHomology.ProductTorus 3) 1) :
