  rw [mappingTorusH2Equiv_boundary, surfacePeriodCover_wangBoundary]
  rfl

theorem Elliptic.HigherHomology.surfacePeriodCoverH3Coordinates_secondMap (j : Elliptic.Kind)
    (p : Elliptic.FixedPeriod j) :
