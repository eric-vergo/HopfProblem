      (isOpen_lt orbitHeightBound_continuous continuous_const)⟩

theorem SpecialPeriods.Triangle.boundedOrbitImage_mono :
    Monotone (fun R : ℝ => (boundedOrbitImage R : Set SpecialPeriods.TriangleOrbitSpace)) := by
  intro R S hRS q hq
