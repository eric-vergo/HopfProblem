    apply Subtype.ext
    apply UpperHalfPlane.ext
    apply SpecialPeriods.Triangle.complex_eq_of_re_eq_norm_add_one_eq
    · exact ht
    · exact (halfFordCirclePoint t : ℍ).im_pos
    · exact (z : ℍ).im_pos
