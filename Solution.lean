abbrev SpecialPeriods.Threefold.CuspAttaching.radius : ℝ :=
  SpecialPeriods.Threefold.specialBaseCover.radius Option.none

attribute [local instance] SpecialPeriods.triangleCompactifiedChartedSpace in
