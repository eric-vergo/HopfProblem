@[simp]
theorem FourthHurewicz.CubeSubdivision.PermutationInsertion.sign_insert {n : ℕ} (k : Fin (n + 1))
    (e : Equiv.Perm (Fin n)) :
    Equiv.Perm.sign (FourthHurewicz.CubeSubdivision.PermutationInsertion.insert k e) =
