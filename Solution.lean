      (SpecialPeriods.Threefold.punctureChart i).symm '' Metric.ball 0 (C.radius i) :=
  SpecialPeriods.Threefold.coordinateDisc_eq_symm_image (SpecialPeriods.Threefold.punctureChart i)
    (C.coordinateBall_subset_target i)

