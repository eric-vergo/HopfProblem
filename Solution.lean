theorem CuspCentralHomology.centralSingularHomology_subsingleton_of_four_lt
    (C : ℂ → Matrix (Fin 2) (Fin 2) ℂ) (r : ℝ) (hr : 0 < r)
    (hC : ∀ i j, ContDiffOn ℂ ω (fun z => C z i j) (Metric.ball 0 r)) {n : ℕ} (hn : 4 < n) :
