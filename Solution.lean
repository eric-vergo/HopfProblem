    MappingTorusHomology.fibreHomologyMap (ThreefoldOverlapMappingTorus.monodromy i) 4 a ∈
      LinearMap.range
        (MappingTorusHomology.fibreHomologyMap (ThreefoldOverlapMappingTorus.monodromy i) 4) :=
