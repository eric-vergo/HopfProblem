  intro q
  induction q with
  | zero =>
    intro a b c
    have heq :
      triplePostcomp_mo1973_13949 (formalAssociatorHomotopy (V := V) (W := W) (Z := Z) 1)
            (SingularMayerVietoris.formalBoundary 4) +
          triplePrecompLast_mo1973_13950 (formalAssociatorHomotopy 0)
            (SingularMayerVietoris.formalBoundary 1) =
