    FirstHurewicz.inducedChain (evaluation x) 2
        (PeriodTorusHigherHomology.crossProductTriangle (BasedLoopSpace x) (unitInterval) 0 a
          (FirstHurewicz.boundaryOne (unitInterval) intervalChain)) =
