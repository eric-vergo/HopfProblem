theorem CuspCentralHomology.centralProject_edgeCylinder_character_dualSide
    (C : ℂ → Matrix (Fin 2) (Fin 2) ℂ) (ε : ℝ) (hε : 0 < ε) (k : Fin 6) (t : unitInterval)
