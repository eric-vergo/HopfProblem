    (L : C(ℝ, SpecialPeriods.TriangleRegularPoint))
    (hL : ∀ (k : ℤ) t, L (t + k) = (SpecialPeriods.Triangle.ellipticGenerator j ^ (-k)) • L t)
    (k : ℤ) (p : ℝ × RealTorus₄) :
    gaugeCylinderMap D L a (MappingTorus.deck (Elliptic.flatTorusAffine j v) k p) =
