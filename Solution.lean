theorem RiemannMapping.triangleClosedDiscHomeomorph_triangle (z : triangleDomain) :
    (triangleClosedDiscHomeomorph (SpecialPeriods.Triangle.triangleClosedInclusion z) : ℂ) =
      triangleMap z := by
