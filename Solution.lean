  apply τ.property
  exact
    ⟨1, 3, by decide, (congrFun (fourSimplexFillA_tetrahedron_two s) 1).trans rfl,
      (congrFun (fourSimplexFillA_tetrahedron_two s) 3).trans rfl⟩

