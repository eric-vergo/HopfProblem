    SingularMayerVietoris.stdVertices, stdSimplex.vertex, Fin.sum_univ_succ, Pi.single_apply]

@[simp]
theorem SecondHurewicz.SimplyConnected.subdivisionUpperPositiveSquareTriangle_one
