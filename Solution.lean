    TriangleUniformizationGluing.ContinuousRemovable Ω T :=
  hS.mono_set_on (fun _ _ hz => hTS hz)

theorem TriangleUniformizationGluing.continuousRemovable_realAxis (Ω : Set ℂ) :
    ContinuousRemovable Ω {z : ℂ | z.im = 0} := by
