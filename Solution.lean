    v i • (t : (PeriodTorusHigherHomology.CircleTopology.Circle)) =
      (((t * (v i : ℝ)) : ℝ) : (PeriodTorusHigherHomology.CircleTopology.Circle))
  rw [← AddCircle.coe_zsmul]
  congr 1
  simp only [zsmul_eq_mul, mul_comm]

