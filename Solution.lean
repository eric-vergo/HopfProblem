          formalAssociatorDefect 1 (SingularMayerVietoris.formalSimplex v)
            (SingularMayerVietoris.formalSimplex w) (SingularMayerVietoris.formalSimplex z)
      have hz :
        SingularMayerVietoris.formalBoundary 3
            (formalAssociatorDefect 1 (SingularMayerVietoris.formalSimplex v)
                (SingularMayerVietoris.formalSimplex w) (SingularMayerVietoris.formalSimplex z) -
