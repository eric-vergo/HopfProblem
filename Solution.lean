@[simp]
theorem ThirdHurewicz.nativeOrderedDuffyMap_swap12 (u : NativeCube) :
    nativeOrderedDuffyMap (Equiv.swap 1 2) u = ![u 0, u 0 * u 2 * u 1, u 0 * u 2] := by
