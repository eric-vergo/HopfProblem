  rw [polarCoord_symm_eq_greenUnit, Complex.real_smul, dbar]
  unfold greenRadial greenAngular
  rw [polar_realLinear_identity, Complex.star_def, ← Complex.inv_eq_conj (norm_greenUnit p.2)]
  field_simp

