  simp only [modularJ, h₄, hΔ, zpow_ofNat, mul_pow, ← pow_mul]
  norm_num
  exact mul_div_mul_left _ _ (pow_ne_zero 12 (UpperHalfPlane.denom_ne_zero γ z))

