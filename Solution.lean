    Metric.ball (0 : ℂ) (C.radius i) ⊆ (SpecialPeriods.Threefold.punctureChart i).target := by
  rw [SpecialPeriods.Threefold.punctureChart_target]
  exact Metric.ball_subset_ball (C.radius_lt_chart i).le

