theorem ThreefoldHomology.ThirdDegree.homologyThreeCyclicMap_eq_zero_iff (z : ℤ) :
    homologyThreeCyclicMap z = 0 ↔ ∃ k : ℤ, k * referenceFibreCoefficient = z := by
