def SixthHurewicz.remainingCubeSide {A : Type} [TopologicalSpace A]
    (f : C(A, Fin 4 → (unitInterval))) : C((unitInterval) × A, Fin 5 → (unitInterval)) :=
  FifthHurewicz.cubeCoordinates.comp ((ContinuousMap.id (unitInterval)).prodMap f)

