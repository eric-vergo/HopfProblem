  have hn : ‖(a : ℂ)‖ ≤ ‖(z : ℂ)‖ := norm_mono_of_re_eq_im_le_mo1973_23882 hre a.im_pos.le him
  have hp : ‖(a : ℂ) + 1‖ ≤ ‖(z : ℂ) + 1‖ := by
