theorem PeriodTorusLineBundle.ChernCocycle.singularSimplex_face_face {X : Type*}
    [TopologicalSpace X] {n : ℕ} (σ : C(FirstHurewicz.Simplex (n + 2), X)) {i j : Fin (n + 2)}
