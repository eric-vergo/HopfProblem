@[simp]
theorem FourthHurewicz.CubeSubdivision.PermutationInsertion.insert_symm_apply_succ {n : ℕ}
    (k : Fin (n + 1)) (e : Equiv.Perm (Fin n)) (j : Fin n) :
    (FourthHurewicz.CubeSubdivision.PermutationInsertion.insert k e).symm j.succ =
