    [CompactSpace X] [T2Space X] (m : ℕ) [NeZero m] (B : X ≃ₜ X) (hB : B ^ m = 1) (k : ℕ) :
    (productCover m B hB).comp ((vCircleMap m k).prodMap (ContinuousMap.id X)) =
