theorem CuspCentralHomology.thetaBeltMap_homologyOne_section (j : Fin 3)
    (a : SingularMayerVietoris.SingularHomology ToricSpace.CompactFibreTorus 1) :
    thetaTargetBeltHomologyEquiv
