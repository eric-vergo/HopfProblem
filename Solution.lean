@[simp]
theorem SecondHurewicz.SimplyConnected.subdivisionUpperPositiveSquareTriangle_zero
    (s : FirstHurewicz.Simplex 2) : (subdivisionUpperPositiveSquareTriangle s 0 : ℝ) = s 1 := by
