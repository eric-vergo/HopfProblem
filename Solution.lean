    (w : ℝ) (hw : 0 < w) (Fc : ℂ → ℂ) (hFc : MeromorphicAt Fc 0)
    (horder : meromorphicOrderAt Fc 0 = (-1 : ℤ)) {c : ℂ}
    (hc : Filter.Tendsto (fun t => t * Fc t) (𝓝[≠] 0) (𝓝 c)) {r₀ : ℝ} (hr₀ : 0 < r₀)
