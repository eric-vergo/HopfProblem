def CuspBoundaryGammaZero.mappingTorusIntersectionMap {X Y : Type} [TopologicalSpace X]
    [TopologicalSpace Y] (f : X ≃ₜ X) (g : Y ≃ₜ Y) (e : C(X, Y)) (he : ∀ x, e (f x) = g (e x)) :
