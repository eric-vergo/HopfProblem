theorem PeriodFamily.Boundary.ellipticSlitBoundaryMap_upper (j : Elliptic.Kind) :
    Set.MapsTo (ellipticSlitBoundaryMap j)
      (MappingTorus.HomologyCover.U (Elliptic.flatTorusAffine j j.twist))
