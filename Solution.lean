theorem SpecialPeriods.TauCusp.exists_global_normalized_lift_of_meromorphic_cusp (F : ℍ → ℂ)
    (hF : MDifferentiable 𝓘(ℂ, ℂ) 𝓘(ℂ, ℂ) F)
    (h₃ :
      ∀ a : ℍ,
        F a = 0 → ∃ k : ℕ, analyticOrderAt (F ∘ UpperHalfPlane.ofComplex) (a : ℂ) = (3 * k : ℕ))
