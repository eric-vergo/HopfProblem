  have hidx : nativeMorseIndex E f zf < 3 := by
    rw [← hindices z zf.property]
    exact hz
  have hother : ∀ j, z.val ≠ (p j).val := by
    intro j hj
    have heq : zf = p j := Subtype.ext hj
    rw [heq, hp j] at hidx
    exact (lt_irrefl _ hidx)
  rw [houtside z zf.property hother]
  exact hcut zf hidx

