theorem SpecialPeriods.Threefold.PiOne.meridian_second_conjugation (v : Lattice) :
    meridian Bool.true * latticeHom (Multiplicative.ofAdd v) * (meridian Bool.true)⁻¹ =
      latticeHom (Multiplicative.ofAdd (A₂ *ᵥ v)) := by
